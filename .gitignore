###############################################################################
# Project-specific
###############################################################################

.claude/*.local.md
.worktrees/

# Client build output served by the API
src/Uniqua.Projector.Api/wwwroot/

# Per-machine settings (appsettings.{Environment}.{MachineName}.json) stay on the machine
src/Uniqua.Projector.Api/appsettings.*.*.json

# Crash dumps written by Git for Windows tools (grep.exe.stackdump and the like)
*.stackdump

###############################################################################
# .NET / ASP.NET Core
###############################################################################

# Build output
# Platform (x64/x86/ARM/ARM64) and publish output land under bin/ or obj/ in this
# solution, so those two already cover them; an unanchored x64/, publish/, etc.
# would otherwise also match unrelated source folders with those names.
[Bb]in/
[Oo]bj/
/[Ll]og/
/[Ll]ogs/
/artifacts/
*.binlog

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates
*.rsuser

# Visual Studio
.vs/

# MSBuild / NuGet
*.nupkg
*.snupkg
/[Pp]ackages/*
!/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
.nuget/

# Tests and coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/
BenchmarkDotNet.Artifacts/

# ASP.NET Core secrets and local data
*.pfx
*.db
*.db-shm
*.db-wal
*.sqlite
*.mdf
*.ldf

# Publish profiles may contain credentials
*.pubxml
*.publishproj
PublishScripts/

###############################################################################
# Node / React (Vite)
###############################################################################

node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Environment files (keep the committed example)
.env
.env.*
!.env.example
*.local

# Package manager logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

###############################################################################
# JetBrains Rider / ReSharper (per-user files)
###############################################################################

# The whole .idea folder is per-user here; team settings live in *.slnx.DotSettings
.idea/
*.iml
*.ipr
*.iws
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
.idea_modules/
riderModule.iml
/_ReSharper.Caches/

###############################################################################
# OS and other editors
###############################################################################

.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.sw?
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
